# Basis-URL des Backends (Dev: lokale IP im selben WLAN, nicht "localhost", da sonst
# auf einem physischen Gerät/Expo Go nicht erreichbar)
EXPO_PUBLIC_API_URL="http://192.168.1.100:3000"

# Native/Expo-Go-Login: muss mit GOOGLE_CLIENT_ID im Backend übereinstimmen
# (aud-Claim-Prüfung). Client-IDs sind nicht geheim.
EXPO_PUBLIC_GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"

# Web-Login (Firebase Authentication) - Werte aus Firebase Console >
# Projekteinstellungen > Meine Apps > Web-App, oder `firebase apps:sdkconfig`.
EXPO_PUBLIC_FIREBASE_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="dein-projekt.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="dein-projekt"
EXPO_PUBLIC_FIREBASE_APP_ID="1:xxxxxxxxxxxx:web:xxxxxxxxxxxxxxxxxxxxxx"
