# Basis-URL des Backends (Dev: lokale IP im selben WLAN, nicht "localhost", da sonst
# auf einem physischen Gerät/Expo Go nicht erreichbar)
EXPO_PUBLIC_API_URL="http://192.168.1.100:3000"

# Muss mit GOOGLE_CLIENT_ID im Backend übereinstimmen (aud-Claim-Prüfung).
# Client-IDs sind nicht geheim.
EXPO_PUBLIC_GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"
