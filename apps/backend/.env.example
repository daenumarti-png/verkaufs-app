# Postgres-Verbindung (Supabase: Project Settings → Database → Connection string).
# Bei Supabase die "Session pooler"-URI nehmen, NICHT "Direct connection" –
# Direct connection ist oft nur per IPv6 erreichbar und schlägt in den meisten
# Heimnetzwerken fehl. Datenbankname bei Supabase ist immer "postgres" (keine
# eigene DB anlegen). Enthält das DB-Passwort Sonderzeichen (z.B. "?", "@", "#"),
# muss es URL-encoded werden (z.B. "?" -> "%3F"), sonst wird die URL falsch geparst.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?schema=public"

# Anthropic API-Key – NIE im Client, nur serverseitig (siehe Sicherheits-Checkliste Briefing Abschnitt 8)
ANTHROPIC_API_KEY=""

# Google OAuth Client-ID für den NATIVEN Login (Expo Go/expo-auth-session,
# Phase 10, console.cloud.google.com → APIs & Services → Credentials). Ist
# NICHT geheim (steht auch im App-Code), aber zentral hier gepflegt. Ohne
# gesetzten Wert werden alle Google-Logins abgelehnt.
GOOGLE_CLIENT_ID=""

# Zweite gültige Client-ID für den WEB-Login (Firebase Authentication, siehe
# apps/mobile/lib/firebase.ts) – von Firebase automatisch provisioniert
# (Firebase Console → Authentication → Sign-in method → Google → Web SDK
# configuration → Web client ID), NICHT dieselbe wie GOOGLE_CLIENT_ID oben.
GOOGLE_CLIENT_ID_WEB=""

# Apple Services-ID/Bundle-ID (Phase 10, developer.apple.com). Ohne gesetzten
# Wert werden alle Apple-Logins abgelehnt.
APPLE_CLIENT_ID=""

# Session-JWT-Signierschlüssel – KEIN externer API-Key, selbst generieren:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""

# Supabase Storage (Phase 12, Bild-Hosting) – gleiches Projekt wie DATABASE_URL,
# aber eigene REST-API-Basis-URL. Project Settings → API.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
# service_role-Key (Project Settings → API → "service_role") – Geheimnis,
# umgeht Row Level Security, NUR serverseitig verwenden.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="item-photos"

# eBay Sell API (Phase 12, developer.ebay.com → My Account → Application Keys,
# zunächst SANDBOX-Keyset). Alle drei Werte sind Geheimnisse.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_RU_NAME=""
EBAY_ENVIRONMENT="SANDBOX"
# eBay-Refresh-Token-Verschlüsselung – KEIN externer Key, selbst generieren:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EBAY_TOKEN_ENCRYPTION_KEY=""

# Stripe-Abrechnung (dashboard.stripe.com → Developers → API keys, TEST-Mode
# beim Entwickeln). Webhook-Secret: Developers → Webhooks → Endpoint anlegen
# (lokal per `stripe listen --forward-to localhost:3000/billing/webhook`,
# das Tool gibt das Secret direkt aus). Price-IDs: Products → Preis anlegen
# für "Basic"/"Pro" (siehe config/subscription.ts für die Kontingente).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_BASIC=""
STRIPE_PRICE_ID_PRO=""

# Server
PORT=3000
NODE_ENV=development

# CORS – Origin der Expo-App im Dev-Betrieb
CORS_ORIGIN="*"
